# DevMind configuration.
# Copy to .env and fill in secrets. Every setting below is loaded through
# src/devmind/core/config.py — never read from os.environ anywhere else.

# --- Providers -----------------------------------------------------------
# Required. No default — the app fails fast rather than run half-configured.
ANTHROPIC_API_KEY=

# Optional. Falls back to the `gh` CLI's own stored auth if unset — but an
# explicit token here is what /health checks before a session ever starts.
GITHUB_TOKEN=

# --- Persistence -----------------------------------------------------------
DATABASE_URL=sqlite:///./devmind.db

# --- Agent -----------------------------------------------------------------
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
MAX_FIX_ATTEMPTS=3
MAX_AGENT_STEPS_PER_PHASE=40
MAX_SESSION_COST_USD=5.0
# Beta server-side context editing (clear_tool_uses_20250919) on agent-loop calls.
# Off until E7 exercises it. See docs/specs/epic-03 section E3-F2-T4.
ENABLE_CONTEXT_EDITING=false

# --- Sandbox -----------------------------------------------------------------
# auto | docker | subprocess
# auto probes the Docker daemon at startup and falls back to subprocess,
# logging a warning — subprocess isolation is process-level only, not a
# security boundary. See docs/01-solution-design.md section 7.
SANDBOX_BACKEND=auto
SANDBOX_COMMAND_TIMEOUT_SECONDS=300
SANDBOX_IMAGE=python:3.12-slim

# --- Workspace -----------------------------------------------------------------
WORKSPACE_ROOT=./workspaces
# Disk ceiling (bytes) across all session workspaces under WORKSPACE_ROOT.
# WorkspaceManager refuses to create a new workspace once usage crosses this.
# Default is 5 GiB.
WORKSPACE_MAX_BYTES=5368709120
MAX_CONCURRENT_SESSIONS=2

# --- Ops -----------------------------------------------------------------
LOG_LEVEL=INFO
# When true, GitService/PRService log the git/gh commands they would run
# instead of executing them. Never affects the approval gate itself.
DRY_RUN=false
